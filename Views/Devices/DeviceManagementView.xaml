<UserControl
    x:Class="SimpleMES.Views.Devices.DeviceManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SimpleMES.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:state="clr-namespace:SimpleMES.Services.State">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:DeviceStateConverter x:Key="DeviceStateConverter" />

        <SolidColorBrush x:Key="PageBgBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSoftBgBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7E3F4" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style
            x:Key="ToolbarButtonStyle"
            BasedOn="{StaticResource MaterialDesignPaperButton}"
            TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                    <Setter Property="Opacity" Value="0.96" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            BasedOn="{StaticResource ToolbarButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style
            x:Key="OutlinedButtonStyle"
            BasedOn="{StaticResource ToolbarButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="Width" Value="320" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" Background="{StaticResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="设备管理" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding State.DeviceOverviewSummary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,10,0" Command="{Binding ResetFiltersCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="FilterOffOutline" />
                        <TextBlock VerticalAlignment="Center" Text="重置筛选" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,10,0" Command="{Binding RefreshViewCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="Refresh" />
                        <TextBlock VerticalAlignment="Center" Text="刷新视图" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding AddDeviceCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding Actions.CanAddDevicePermission, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="White" Kind="PlusCircleOutline" />
                        <TextBlock VerticalAlignment="Center" Text="新增设备" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Margin="0,18,0,0" Columns="4">
            <Border Margin="0,0,12,0" Padding="16" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#065F46" Text="运行中" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#065F46" Text="{Binding State.RunningCount}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="16" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#92400E" Text="断连中" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#92400E" Text="{Binding State.DisconnectedCount}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="16" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" Text="故障设备" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#991B1B" Text="{Binding State.FaultCount}" />
                </StackPanel>
            </Border>
            <Border Padding="16" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#1D4ED8" Text="筛选结果" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8" Text="{Binding State.FilteredDeviceDto.Count}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Margin="0,18,0,0" Padding="18" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="搜索设备" />
                        <DockPanel Margin="0,6,0,0">
                            <Border Width="36" Height="36" Margin="0,0,8,0" Background="#DBEAFE" CornerRadius="10">
                                <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" Kind="Magnify" />
                            </Border>
                            <TextBox Height="36" Text="{Binding State.SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="状态筛选" />
                        <DockPanel Margin="0,6,0,0">
                            <Border Width="36" Height="36" Margin="0,0,8,0" Background="#DBEAFE" CornerRadius="10">
                                <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" Kind="TuneVariant" />
                            </Border>
                            <ComboBox Height="36" ItemsSource="{Binding State.StateFilterOptions}" SelectedItem="{Binding State.StateFilter, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="每页显示" />
                        <ComboBox Height="36" Margin="0,6,0,0" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding VisibleRangeSummary}" />

                    <WrapPanel Grid.Column="1">
                        <Button Margin="0,0,8,0" Command="{Binding FilterAllCommand}" Style="{StaticResource OutlinedButtonStyle}" Content="全部" />
                        <Button Margin="0,0,8,0" Command="{Binding FilterRunningCommand}" Style="{StaticResource OutlinedButtonStyle}" Content="运行中" />
                        <Button Margin="0,0,8,0" Command="{Binding FilterDisconnectedCommand}" Style="{StaticResource OutlinedButtonStyle}" Content="断连" />
                        <Button Command="{Binding FilterFaultCommand}" Style="{StaticResource OutlinedButtonStyle}" Content="故障" />
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding State.HasFilteredDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding VisibleDevices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding DeviceName}" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding IpAddress}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding SerialPort}" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Padding="10,4" BorderThickness="1" CornerRadius="999">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                                                            <Setter Property="Background" Value="#FFFBEB" />
                                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                            <Setter Property="BorderBrush" Value="#D1D5DB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DeviceState, Converter={StaticResource DeviceStateConverter}}" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Margin="0,0,6,0" Padding="10" Background="#EFF6FF" CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="温度 (℃)" />
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1D4ED8" Text="{Binding Temperature}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Margin="0,0,6,0" Padding="10" Background="#FFFBEB" CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="压力 (Bar)" />
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#B45309" Text="{Binding Pressure}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="10" Background="#FEF2F2" CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="转速 (Rpm)" />
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#991B1B" Text="{Binding Speed}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlinedButtonStyle}"
                                            Visibility="{Binding DataContext.Actions.CanEditDevicePermission, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="PencilOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="编辑设备" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding DataContext.ToggleDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.Actions.CanToggleDevicePermission, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Background" Value="#DC2626" />
                                                    <Setter Property="BorderBrush" Value="#DC2626" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                            <Setter Property="Background" Value="#059669" />
                                                            <Setter Property="BorderBrush" Value="#059669" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Content>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="停用设备" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                                    <Setter Property="Text" Value="启用设备" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>
                                    </Grid>

                                    <TextBlock Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="{Binding LastUpdateTime, StringFormat='最后更新：{0:yyyy-MM-dd HH:mm:ss}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Padding="28" Background="{StaticResource CardSoftBgBrush}" BorderBrush="#E2EAF6" BorderThickness="1" CornerRadius="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.HasFilteredDevices}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="56" Height="56" HorizontalAlignment="Left" Background="#DBEAFE" CornerRadius="28">
                        <materialDesign:PackIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" Kind="Chip" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding State.ManagementEmptyTitle}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding State.ManagementEmptyDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding PagingSummary}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,10,0" Command="{Binding PreviousPageCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="ChevronLeft" />
                        <TextBlock VerticalAlignment="Center" Text="上一页" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NextPageCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="下一页" />
                        <materialDesign:PackIcon Width="16" Height="16" Margin="8,0,0,0" Foreground="#2563EB" Kind="ChevronRight" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
