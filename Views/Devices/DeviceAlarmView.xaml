<UserControl
    x:Class="SimpleMES.Views.Devices.DeviceAlarmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <SolidColorBrush x:Key="PageBgBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSoftBgBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7E3F4" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style
            x:Key="ToolbarButtonStyle"
            BasedOn="{StaticResource MaterialDesignPaperButton}"
            TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                    <Setter Property="Opacity" Value="0.96" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            BasedOn="{StaticResource ToolbarButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style
            x:Key="OutlinedButtonStyle"
            BasedOn="{StaticResource ToolbarButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" Background="{StaticResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="设备告警" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding FilteredAlarmSummary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,10,0" Command="{Binding ResetFiltersCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="FilterOffOutline" />
                        <TextBlock VerticalAlignment="Center" Text="重置筛选" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding AckVisibleAlarmsCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding Actions.CanAckAlarmPermission, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="White" Kind="CheckAll" />
                        <TextBlock VerticalAlignment="Center" Text="批量确认当前筛选" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshAlarmsCommand}" Style="{StaticResource OutlinedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="Refresh" />
                        <TextBlock VerticalAlignment="Center" Text="刷新告警" />
                    </StackPanel>
                </Button>
                <Button Margin="10,0,0,0" IsEnabled="False" Style="{StaticResource OutlinedButtonStyle}" ToolTip="{Binding HistoryEntryText}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#94A3B8" Kind="History" />
                        <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" Text="历史告警" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Margin="0,18,0,0" Columns="4">
            <Border Margin="0,0,12,0" Padding="16" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#1D4ED8" Text="未确认总数" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8" Text="{Binding State.PendingAlarms.Count}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="16" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" Text="严重告警" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#991B1B" Text="{Binding CriticalCount}" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="16" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#92400E" Text="普通告警" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#92400E" Text="{Binding WarningCount}" />
                </StackPanel>
            </Border>
            <Border Padding="16" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#047857" Text="提醒" />
                    <TextBlock Margin="0,10,0,0" FontSize="28" FontWeight="Bold" Foreground="#047857" Text="{Binding NoticeCount}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Margin="0,18,0,0" Padding="18" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="搜索告警 / 设备号" />
                    <DockPanel Margin="0,6,0,0">
                        <Border Width="36" Height="36" Margin="0,0,8,0" Background="#DBEAFE" CornerRadius="10">
                            <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" Kind="Magnify" />
                        </Border>
                        <TextBox Height="36" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="告警级别" />
                    <DockPanel Margin="0,6,0,0">
                        <Border Width="36" Height="36" Margin="0,0,8,0" Background="#DBEAFE" CornerRadius="10">
                            <materialDesign:PackIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" Kind="TuneVariant" />
                        </Border>
                        <ComboBox Height="36" ItemsSource="{Binding SeverityFilterOptions}" SelectedItem="{Binding SeverityFilter, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding VisibleAlarms}" Visibility="{Binding HasVisibleAlarms, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18" BorderThickness="1" CornerRadius="18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFBEB" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                                            <Setter Property="Background" Value="#FEF2F2" />
                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SeverityKey}" Value="Notice">
                                            <Setter Property="Background" Value="#ECFDF5" />
                                            <Setter Property="BorderBrush" Value="#A7F3D0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="10,4" BorderThickness="1" CornerRadius="999">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFBEB" />
                                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                            <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SeverityKey}" Value="Notice">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding SeverityText}" />
                                        </Border>
                                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding DeviceId, StringFormat=设备 #{0}}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding AlarmMessage}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding AlarmTime, StringFormat='发生时间：{0:yyyy-MM-dd HH:mm:ss}'}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.AckAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource OutlinedButtonStyle}"
                                    Visibility="{Binding DataContext.Actions.CanAckAlarmPermission, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="#2563EB" Kind="CheckCircleOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="确认" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Padding="28" Background="{StaticResource CardSoftBgBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVisibleAlarms}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <Border Width="56" Height="56" HorizontalAlignment="Left" Background="#DBEAFE" CornerRadius="28">
                        <materialDesign:PackIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2563EB" Kind="BellCheckOutline" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding EmptyStateTitle}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding EmptyStateDescription}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
