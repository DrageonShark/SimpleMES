<UserControl
    x:Class="SimpleMES.Views.Devices.DeviceBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimpleMES.Views.Controls"
    xmlns:converters="clr-namespace:SimpleMES.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:state="clr-namespace:SimpleMES.Services.State">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:DeviceStateConverter x:Key="DeviceStateConverter" />

        <SolidColorBrush x:Key="PageBgBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSoftBgBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7E3F4" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style
            x:Key="ToolbarButtonStyle"
            BasedOn="{StaticResource MaterialDesignPaperButton}"
            TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                    <Setter Property="Opacity" Value="0.96" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            BasedOn="{StaticResource ToolbarButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="BoardCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#A7F3D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                    <Setter Property="Background" Value="#FFFBEB" />
                    <Setter Property="BorderBrush" Value="#FDE68A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FECACA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#065F46" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                    <Setter Property="Foreground" Value="#92400E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                    <Setter Property="Foreground" Value="#991B1B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FocusCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource CardSoftBgBrush}" />
            <Setter Property="BorderBrush" Value="#E2EAF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="InfoChipStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7E3F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" Background="{StaticResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextBrush}"
                    Text="设备看板" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource MutedBrush}"
                    Text="{Binding State.DeviceOverviewSummary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding AddDeviceCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding Actions.CanAddDevicePermission, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            Foreground="White"
                            Kind="PlusCircleOutline" />
                        <TextBlock VerticalAlignment="Center" Text="新增设备" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding DataContext.ShowManagementCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:DeviceShellView}}}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            Foreground="#2563EB"
                            Kind="CogOutline" />
                        <TextBlock VerticalAlignment="Center" Text="设备管理" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.ShowAlarmCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:DeviceShellView}}}" Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            Foreground="#2563EB"
                            Kind="AlertOutline" />
                        <TextBlock VerticalAlignment="Center" Text="设备告警" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Height="260"
            Margin="0,12,0,0"
            Padding="16"
            Background="White"
            BorderBrush="#BFDBFE"
            BorderThickness="1"
            CornerRadius="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border
                        Width="60"
                        Height="60"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="30">
                        <materialDesign:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource PrimaryBrush}"
                            Kind="ViewDashboardOutline" />
                    </Border>
                    <TextBlock
                        Margin="0,18,0,0"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}"
                        Text="{Binding State.BoardHeadline}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="{Binding State.BoardDescription}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Padding="18"
                    Background="#F8FBFF"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="最新未确认告警" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{Binding State.AlarmSummary}" />
                        <Border
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#B91C1C"
                                    Text="告警预览" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="#7F1D1D"
                                    Text="{Binding State.LatestAlarmPreview}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button
                            Margin="0,16,0,0"
                            Command="{Binding RefreshAlarmsCommand}"
                            Style="{StaticResource ToolbarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Foreground="#2563EB"
                                    Kind="Refresh" />
                                <TextBlock VerticalAlignment="Center" Text="刷新告警摘要" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,14,0,0"
            Padding="14,12"
            Background="White"
            BorderBrush="#D7E3F4"
            BorderThickness="1"
            CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="状态统计" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding State.DeviceOverviewSummary}" />
                </StackPanel>

                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Margin="0,0,10,6" Padding="12,8" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#065F46" Text="运行中" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#065F46" Text="{Binding State.RunningCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,6" Padding="12,8" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#92400E" Text="断连中" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#92400E" Text="{Binding State.DisconnectedCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,6" Padding="12,8" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#991B1B" Text="故障设备" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#991B1B" Text="{Binding State.FaultCount}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,6" Padding="12,8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="999">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#1D4ED8" Text="停用设备" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="#1D4ED8" Text="{Binding State.DisabledCount}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BoardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextBrush}"
                                Text="待处理设备" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Foreground="{StaticResource MutedBrush}"
                                Text="{Binding State.AttentionSummary}" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Padding="12,6"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="999">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#1D4ED8"
                                Text="{Binding State.AttentionDeviceCount, StringFormat='待处理 {0} 台'}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,-6,0">
                        <ScrollViewer
                            Padding="0,0,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding State.HasAttentionDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding State.SpotlightDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FocusCardStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="6" CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FDE68A" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                                                                        <Setter Property="Background" Value="#FCA5A5" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="14,0,18,0">
                                                        <TextBlock
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource TextBrush}"
                                                            Text="{Binding DeviceName}" />
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            Text="{Binding LocationSummary}" />
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            Text="{Binding DeviceAddress, StringFormat='通信地址：{0}'}" />
                                                        <WrapPanel Margin="0,12,0,0">
                                                            <Border Style="{StaticResource InfoChipStyle}">
                                                                <TextBlock Foreground="#475569" Text="{Binding CurrentOrderSummary}" />
                                                            </Border>
                                                            <Border Style="{StaticResource InfoChipStyle}">
                                                                <TextBlock Foreground="#475569" Text="{Binding HeartbeatSummary}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            Text="{Binding StateAgeSummary}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeBorderStyle}">
                                                        <TextBlock Style="{StaticResource StatusBadgeTextStyle}" Text="{Binding DeviceState, Converter={StaticResource DeviceStateConverter}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border
                                    Padding="16"
                                    Background="#F8FBFF"
                                    BorderBrush="#D7E3F4"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Visibility="{Binding State.HasSpotlightOverflow, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"
                                                Text="{Binding State.SpotlightOverflowSummary}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Foreground="{StaticResource MutedBrush}"
                                                Text="其余异常设备建议在设备管理页统一筛选处理。" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Command="{Binding DataContext.ShowManagementCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:DeviceShellView}}}"
                                            Style="{StaticResource ToolbarButtonStyle}">
                                            <TextBlock Text="前往管理" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border
                            Padding="24"
                            Background="{StaticResource CardSoftBgBrush}"
                            BorderBrush="#E2EAF6"
                            BorderThickness="1"
                            CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.HasAttentionDevices}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="54"
                                    Height="54"
                                    Background="#DBEAFE"
                                    CornerRadius="27">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#2563EB"
                                        Kind="ShieldCheckOutline" />
                                </Border>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextBrush}"
                                    Text="当前没有待处理异常设备" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="断连和故障设备会优先进入这里，便于值班人员先处理最影响生产的设备。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BoardCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextBrush}"
                                Text="最近状态更新" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Foreground="{StaticResource MutedBrush}"
                                Text="{Binding State.RecentEventSummary}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding DataContext.ShowManagementCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:DeviceShellView}}}"
                                Style="{StaticResource ToolbarButtonStyle}">
                                <TextBlock Text="管理" />
                            </Button>
                            <Button Command="{Binding DataContext.ShowAlarmCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:DeviceShellView}}}" Style="{StaticResource ToolbarButtonStyle}">
                                <TextBlock Text="告警" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,-6,0">
                        <ScrollViewer
                            Padding="0,0,6,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding State.HasRecentEvents, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding State.BoardRecentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                <Border
                                                    Width="2"
                                                    Margin="0,14,0,0"
                                                    Background="#D7E3F4" />
                                                <Border
                                                    Width="10"
                                                    Height="10"
                                                    Margin="0,8,0,0"
                                                    Background="#2563EB"
                                                    CornerRadius="5" />
                                            </Grid>

                                            <Border
                                                Grid.Column="1"
                                                Padding="16"
                                                Background="{StaticResource CardSoftBgBrush}"
                                                BorderBrush="#E2EAF6"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                        <TextBlock
                                                            FontSize="17"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource TextBrush}"
                                                            Text="{Binding DeviceName}" />
                                                        <TextBlock
                                                            Margin="0,6,0,0"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            Text="{Binding LocationSummary}" />
                                                        <TextBlock
                                                            Margin="0,8,0,0"
                                                            Foreground="#334155"
                                                            Text="{Binding EventMessage}"
                                                            TextWrapping="Wrap" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Border Style="{StaticResource InfoChipStyle}">
                                                                <TextBlock Foreground="#475569" Text="{Binding OccurredAtSummary}" />
                                                            </Border>
                                                            <Border Style="{StaticResource InfoChipStyle}">
                                                                <TextBlock Foreground="#475569" Text="{Binding SnapshotStateText, StringFormat='状态快照：{0}'}" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            Foreground="#475569"
                                                            Text="{Binding ResolutionSummary}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="12,8" BorderThickness="1" CornerRadius="999">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#EFF6FF" />
                                                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EventLevel}" Value="Critical">
                                                                        <Setter Property="Background" Value="#FEF2F2" />
                                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EventLevel}" Value="Warning">
                                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                                        <Setter Property="BorderBrush" Value="#FDE68A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding EventLevelText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EventLevel}" Value="Critical">
                                                                            <Setter Property="Foreground" Value="#991B1B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding EventLevel}" Value="Warning">
                                                                            <Setter Property="Foreground" Value="#92400E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border
                            Padding="24"
                            Background="{StaticResource CardSoftBgBrush}"
                            BorderBrush="#E2EAF6"
                            BorderThickness="1"
                            CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.HasRecentEvents}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="54"
                                    Height="54"
                                    Background="#DBEAFE"
                                    CornerRadius="27">
                                    <materialDesign:PackIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="#2563EB"
                                        Kind="Pulse" />
                                </Border>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextBrush}"
                                    Text="等待状态刷新" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="设备开始产生通信记录或状态变化后，这里会按最近更新时间展示最新动态。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
