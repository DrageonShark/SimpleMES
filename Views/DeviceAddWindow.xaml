<Window x:Class="SimpleMES.Views.DeviceAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleMES.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F7F8"
        Title="添加设备" Height="360" Width="420">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="UniversalTBk">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox"  x:Key="UniversalTBx">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="34"/>
        </Style>
    </Window.Resources>
    <Border 
        Margin="16" 
        Padding="20"
        Background="White"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                Color="#1A000000"
                BlurRadius="14"
                ShadowDepth="2"
                Opacity="0.4"/>
        </Border.Effect>
        <Grid RowSpan="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock
                    Style="{StaticResource UniversalTBk}"
                Text="设备添加"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#1F2937"/>
                <TextBlock 
                    Style="{StaticResource UniversalTBk}"
                Text="请填写设备配置信息"
                FontSize="12"
                FontWeight="Bold"
                Foreground="#6B7280"
                Margin="0 4 0 0"/>
            </StackPanel>
            <Grid 
                Grid.Row="1"
                RowSpan="12"
                ColumnSpan="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                Grid.Row="0" 
                Grid.Column="0"
                Text="设备名" 
                Style="{StaticResource UniversalTBk}"/>
                <TextBox 
                    Style="{StaticResource UniversalTBx}"
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                />
                <TextBlock 
                Grid.Row="1"
                Grid.Column="0"
                Text="IP地址" 
                Style="{StaticResource UniversalTBk}"/>
                <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource UniversalTBx}"/>
                <TextBlock 
                Grid.Row="2"
                Grid.Column="0"
                Text="端口" 
                Style="{StaticResource UniversalTBk}"/>
                <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableNumberConverter}}"
                Style="{StaticResource UniversalTBx}"/>
                <TextBlock 
                Grid.Row="3"
                Grid.Column="0"
                Text="串口" 
                Style="{StaticResource UniversalTBk}"/>
                <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding SerialPort, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource UniversalTBx}"/>
                <TextBlock 
                Grid.Row="4"
                Grid.Column="0"
                Text="从站号" 
                Style="{StaticResource UniversalTBk}"/>
                <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Text="{Binding SlaveId, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableNumberConverter}}"
                Style="{StaticResource UniversalTBx}"/>
            </Grid>
            <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0 ">
                <Button
                        Content="确定"
                        Width="80"
                        Height="34"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#2563EB"
                        Cursor="Hand"
                        Click="OnSure"
                        IsDefault="True"/>
                <Button
                        Content="取消"
                        Width="80"
                        Height="34"
                        Background="#E5E7E8"
                        Foreground="#374151"
                        BorderBrush="#E5E7EB"
                        IsCancel="True"
                        Margin="10 0 0 0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
