<Window x:Class="SimpleMES.Views.DeviceAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加设备"
        Width="400" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="设备名称" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="IP 地址" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="端口" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="串口" VerticalAlignment="Center" Margin="0,8"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SerialPort, UpdateSourceTrigger=PropertyChanged}"
                 Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,8"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" Margin="0,0,10,0"
                    Click="OnCancelClick"/>
            <Button Content="确定" Width="80" Height="32"
                    Background="#1976D2" Foreground="White" BorderThickness="0"
                    Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
