<Window x:Class="SimpleMES.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Width="340"
        SizeToContent="Height">

    <!-- 外层提供阴影扩散空间 -->
    <Border Padding="10">
        <!-- 中层承载阴影效果 -->
        <Border CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect 
                    BlurRadius="16" 
                    ShadowDepth="3" 
                    Direction="270"
                    Opacity="0.25" 
                    Color="#000000"/>
            </Border.Effect>
            <!-- 内层裁剪圆角 -->
            <Border 
                CornerRadius="8" 
                ClipToBounds="True" 
                Background="White">
                <StackPanel>
                    <!-- ① 顶部色带：类型标题 + 关闭按钮 -->
                    <Border x:Name="HeaderBorder" 
                            Height="40" 
                            Padding="14 0 6 0" 
                            CornerRadius="8 8 0 0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock 
                                x:Name="TitleText"
                                DockPanel.Dock="Left"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                FontFamily="Microsoft YaHei UI"
                                VerticalAlignment="Center"/>
                            <Button 
                                x:Name="HeaderCloseBtn"
                                DockPanel.Dock="Right"
                                Content="✕"
                                Width="30" Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="13"
                                Cursor="Hand"
                                Padding="0"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Red"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- ② 内容区：图标 + 消息 + 时间 -->
                    <Border Background="White" Padding="16 14 16 10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                x:Name="StatusIcon"
                                Grid.Column="0"
                                Width="38" Height="38"
                                VerticalAlignment="Top"
                                Margin="0 2 14 0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="MessageText"
                                           Foreground="#333333"
                                           FontSize="13"
                                           FontFamily="Microsoft YaHei UI"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="DateTimeText"
                                           Foreground="#999999"
                                           FontSize="11"
                                           FontFamily="Microsoft YaHei UI"
                                           Margin="0 6 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 分隔线 -->
                    <Rectangle Height="1" Fill="#EEEEEE"/>

                    <!-- ③ 底栏：确认 / 关闭 按钮 + 圆形进度环 -->
                    <Border 
                        Background="White" 
                        Padding="16 10 12 10" 
                        CornerRadius="0 0 8 8">
                        <DockPanel>
                            <!-- 进度环停靠在右侧 -->
                            <Canvas DockPanel.Dock="Right"
                                    Width="28" Height="28"
                                    VerticalAlignment="Center">
                                <!-- 灰色背景圆 -->
                                <Ellipse Width="24" Height="24"
                                         Canvas.Left="2" Canvas.Top="2"
                                         Stroke="#E8E8E8" StrokeThickness="3"
                                         Fill="Transparent"/>
                                <!-- 橙色倒计时弧线 -->
                                <Path x:Name="ProgressRing"
                                      Stroke="#FFA500" StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.Data>
                                        <!-- 圆心在 Canvas 中央 (14,14)，半径 12 -->
                                        <EllipseGeometry Center="14,14" RadiusX="12" RadiusY="12"/>
                                    </Path.Data>
                                    <!-- 旋转 -90° 使弧线从 12 点钟方向开始 -->
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>

                            <!-- 按钮组 -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <Button x:Name="ConfirmBtn"
                                        Content="确认"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#1976D2"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        FontFamily="Microsoft YaHei UI"
                                        Cursor="Hand"
                                        Padding="0"
                                        Margin="0 0 30 0"/>
                                <Button x:Name="CloseBtn"
                                        Content="关闭"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#FF8C00"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        FontFamily="Microsoft YaHei UI"
                                        Cursor="Hand"
                                        Padding="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Border>
</Window>
