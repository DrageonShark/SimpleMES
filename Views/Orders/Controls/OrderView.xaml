<UserControl
    x:Class="SimpleMES.Views.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SimpleMES.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:OrderStatusConverter x:Key="OrderStatusConverter" />
        <SolidColorBrush x:Key="PageBgBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSoftBgBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7E3F4" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style
            x:Key="BaseSolidButtonStyle"
            BasedOn="{StaticResource MaterialDesignPaperButton}"
            TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Setter Property="materialDesign:RippleAssist.Feedback" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PrimaryButtonStyle"
            BasedOn="{StaticResource BaseSolidButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
        </Style>
        <Style
            x:Key="SuccessButtonStyle"
            BasedOn="{StaticResource BaseSolidButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#059669" />
        </Style>
        <Style
            x:Key="DangerButtonStyle"
            BasedOn="{StaticResource BaseSolidButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
        </Style>
        <Style
            x:Key="OutlinedActionButtonStyle"
            BasedOn="{StaticResource MaterialDesignOutlinedButton}"
            TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style
            x:Key="OrderGridStyle"
            BasedOn="{x:Null}"
            TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF8" />
            <Setter Property="VerticalGridLinesBrush" Value="#E8EEF8" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFCFF" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style x:Key="OrderGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Background" Value="#F4F8FF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#D7E3F4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="OrderGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FBFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" Background="{StaticResource PageBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.35*" />
            <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="20"
            Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"
                            Text="订单列表" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            Text="选择订单后，可在右侧执行调度和状态流转。" />
                        <TextBlock
                            Foreground="#1D4ED8"
                            Text="(状态流转：Pending → Producing → Paused → Producing → Completed)"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        MinWidth="88"
                        Command="{Binding LoadOrdersCommand}"
                        Content="刷新"
                        Style="{StaticResource OutlinedActionButtonStyle}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="8"
                    Background="{StaticResource CardSoftBgBrush}"
                    BorderBrush="#E2EAF6"
                    BorderThickness="1"
                    CornerRadius="14">
                    <DataGrid
                        CellStyle="{StaticResource OrderGridCellStyle}"
                        ColumnHeaderStyle="{StaticResource OrderGridHeaderStyle}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Orders}"
                        RowStyle="{StaticResource OrderGridRowStyle}"
                        SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                        Style="{StaticResource OrderGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding OrderNo}"
                                Header="工单号" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding ProductCode}"
                                Header="产品" />
                            <DataGridTextColumn
                                Width="86"
                                Binding="{Binding PlanQty}"
                                Header="计划数" />
                            <DataGridTextColumn
                                Width="86"
                                Binding="{Binding CompletedQty}"
                                Header="已完成" />
                            <DataGridTemplateColumn Width="110" Header="状态">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="StatusBadge"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Background="#EFF6FF"
                                            BorderBrush="#BFDBFE"
                                            BorderThickness="1"
                                            CornerRadius="999">
                                            <TextBlock
                                                x:Name="StatusText"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="#1D4ED8"
                                                Text="{Binding OrderStatus, Converter={StaticResource OrderStatusConverter}}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FFF7ED" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FED7AA" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#C2410C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Producing">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#ECFDF5" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#A7F3D0" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#047857" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Paused">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3C7" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FDE68A" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#B45309" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#BFDBFE" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                Header="创建时间" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="16,0,0,0"
            Padding="20"
            Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}"
                        Text="调度面板" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="当前对选中订单执行运行、暂停和完工操作。" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Border
                        Padding="16"
                        Background="{StaticResource CardSoftBgBrush}"
                        BorderBrush="#E2EAF6"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedOrder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="当前订单" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"
                                Text="{Binding SelectedOrder.OrderNo}" />
                            <TextBlock
                                Margin="0,16,0,6"
                                Foreground="{StaticResource MutedBrush}"
                                Text="状态" />
                            <Border
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="999">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Pending">
                                                <Setter Property="Background" Value="#FFF7ED" />
                                                <Setter Property="BorderBrush" Value="#FED7AA" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Producing">
                                                <Setter Property="Background" Value="#ECFDF5" />
                                                <Setter Property="BorderBrush" Value="#A7F3D0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Paused">
                                                <Setter Property="Background" Value="#FEF3C7" />
                                                <Setter Property="BorderBrush" Value="#FDE68A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Completed">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#1D4ED8"
                                    Text="{Binding SelectedOrder.OrderStatus, Converter={StaticResource OrderStatusConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Pending">
                                                    <Setter Property="Foreground" Value="#C2410C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Producing">
                                                    <Setter Property="Foreground" Value="#047857" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Paused">
                                                    <Setter Property="Foreground" Value="#B45309" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedOrder.OrderStatus}" Value="Completed">
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock
                                Margin="0,16,0,4"
                                Foreground="{StaticResource MutedBrush}"
                                Text="产品" />
                            <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding SelectedOrder.ProductCode}" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="{StaticResource MutedBrush}"
                                Text="计划数 / 完成数" />
                            <TextBlock Foreground="{StaticResource TextBrush}"><Run Text="{Binding SelectedOrder.PlanQty}" /><Run Text=" / " /><Run Text="{Binding SelectedOrder.CompletedQty}" /></TextBlock>
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="{StaticResource MutedBrush}"
                                Text="最后操作时间" />
                            <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding SelectedOrder.LastOperationTime, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue=-}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="15"
                        Background="#F8FBFF"
                        BorderBrush="#D7E3F4"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedOrder}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <Border
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    Background="#DBEAFE"
                                    CornerRadius="28"
                                    DockPanel.Dock="Left">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Foreground="#2563EB"
                                        Kind="InformationOutline" />
                                </Border>
                                <TextBlock
                                    Margin="0,10,0,0"
                                    DockPanel.Dock="Right"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextBrush}"
                                    Text="{Binding EmptyStateTitle}" />
                            </DockPanel>

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{StaticResource MutedBrush}"
                                Text="{Binding EmptyStateDescription}"
                                TextWrapping="Wrap" />
                            <StackPanel Margin="0,20,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="#DBEAFE"
                                        CornerRadius="12">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="#1D4ED8"
                                            Text="1" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,2,0,0"
                                        Foreground="{StaticResource TextBrush}"
                                        Text="从左侧列表中选择需要调度的订单。"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="#DBEAFE"
                                        CornerRadius="12">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="#1D4ED8"
                                            Text="2" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,2,0,0"
                                        Foreground="{StaticResource TextBrush}"
                                        Text="确认右侧状态、计划数与最后操作时间。"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="24"
                                        Height="24"
                                        Background="#DBEAFE"
                                        CornerRadius="12">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="#1D4ED8"
                                            Text="3" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,2,0,0"
                                        Foreground="{StaticResource TextBrush}"
                                        Text="根据当前状态执行开始、暂停或完工。"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Button
                        Margin="0,0,0,10"
                        Command="{Binding StartSelectedOrderCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Foreground="White"
                                Kind="PlayCircleOutline" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="执行 / 恢复" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="0,0,0,10"
                        Command="{Binding PauseSelectedOrderCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Visibility="{Binding ShowPauseButton, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Foreground="White"
                                Kind="PauseCircleOutline" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="暂停" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding CompleteSelectedOrderCommand}"
                        Style="{StaticResource SuccessButtonStyle}"
                        Visibility="{Binding ShowCompleteButton, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Foreground="White"
                                Kind="CheckCircleOutline" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="完工" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        Margin="0,14,0,0"
                        Foreground="{StaticResource MutedBrush}"
                        Text="操作按钮会按权限和当前订单状态自动启用。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
