<UserControl
    x:Class="SimpleMES.Views.Controls.OrderBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Width="75"
            Margin="0,0,0,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Command="{Binding LoadOrdersCommand}"
            Content="刷新" />

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Orders}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding OrderNo}"
                    Header="工单号" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding ProductCode}"
                    Header="产品" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding PlanQty}"
                    Header="计划数" />
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding CompletedQty}"
                    Header="已完成" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding OrderStatus}"
                    Header="状态" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}"
                    Header="创建时间" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
