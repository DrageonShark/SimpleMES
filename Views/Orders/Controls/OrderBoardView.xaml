<UserControl
    x:Class="SimpleMES.Views.Controls.OrderBoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SimpleMES.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:OrderStatusConverter x:Key="OrderStatusConverter" />

        <SolidColorBrush x:Key="PageBgBrush" Color="#F4F8FF" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardSoftBgBrush" Color="#F8FBFF" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D7E3F4" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />

        <Style
            x:Key="ToolbarButtonStyle"
            BasedOn="{StaticResource MaterialDesignPaperButton}"
            TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Setter Property="materialDesign:RippleAssist.Feedback" Value="#2563EB" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="OrderGridStyle"
            BasedOn="{x:Null}"
            TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF8" />
            <Setter Property="VerticalGridLinesBrush" Value="#E8EEF8" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFCFF" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>

        <Style x:Key="OrderGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Background" Value="#F4F8FF" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#D7E3F4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="OrderGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FBFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" Background="{StaticResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextBrush}"
                    Text="订单看板" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource MutedBrush}"
                    Text="{Binding OrdersSummary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding ClearFiltersCommand}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                Foreground="#2563EB"
                                Kind="FilterOffOutline" />
                            <TextBlock VerticalAlignment="Center" Text="重置" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Command="{Binding LoadOrdersCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                Foreground="#2563EB"
                                Kind="Refresh" />
                            <TextBlock VerticalAlignment="Center" Text="刷新" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid
            Grid.Row="1"
            Margin="0,10,0,0"
            Columns="4">
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="#FFF7ED"
                BorderBrush="#FED7AA"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#C2410C" Text="待产订单" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#C2410C"
                        Text="{Binding PendingCount}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#047857" Text="生产中" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#047857"
                        Text="{Binding ProducingCount}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="#FEF3C7"
                BorderBrush="#FDE68A"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#B45309" Text="已暂停" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#B45309"
                        Text="{Binding PausedCount}" />
                </StackPanel>
            </Border>
            <Border
                Padding="12"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel>
                    <TextBlock Foreground="#1D4ED8" Text="已完工" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#1D4ED8"
                        Text="{Binding CompletedCount}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="搜索" />
                <TextBox
                    Height="36"
                    Margin="0,6,0,0"
                    Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="状态" />
                <ComboBox
                    Height="36"
                    Margin="0,6,0,0"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding StatusFilterOptions}"
                    SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"
                    SelectedValuePath="Key" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Foreground="{StaticResource MutedBrush}" Text="显示条数" />
                <ComboBox
                    Height="36"
                    Margin="0,6,0,0"
                    ItemsSource="{Binding OrderLimitOptions}"
                    SelectedItem="{Binding OrderLimit, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,18,0,0"
            Padding="8"
            Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <DataGrid
                    CellStyle="{StaticResource OrderGridCellStyle}"
                    ColumnHeaderStyle="{StaticResource OrderGridHeaderStyle}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Orders}"
                    RowStyle="{StaticResource OrderGridRowStyle}"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                    Style="{StaticResource OrderGridStyle}"
                    Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding OrderNo}"
                            Header="工单号" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding ProductCode}"
                            Header="产品" />
                        <DataGridTextColumn
                            Width="86"
                            Binding="{Binding PlanQty}"
                            Header="计划数" />
                        <DataGridTextColumn
                            Width="86"
                            Binding="{Binding CompletedQty}"
                            Header="已完成" />
                        <DataGridTemplateColumn Width="110" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="StatusBadge"
                                        Padding="10,4"
                                        HorizontalAlignment="Left"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="999">
                                        <TextBlock
                                            x:Name="StatusText"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#1D4ED8"
                                            Text="{Binding OrderStatus, Converter={StaticResource OrderStatusConverter}}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#FFF7ED" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FED7AA" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#C2410C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Producing">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#ECFDF5" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#A7F3D0" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#047857" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Paused">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3C7" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FDE68A" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#B45309" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#EFF6FF" />
                                            <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#BFDBFE" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                            Header="创建时间" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border
                    Padding="28"
                    Background="{StaticResource CardSoftBgBrush}"
                    CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOrders}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Left"
                            Background="#DBEAFE"
                            CornerRadius="28">
                            <materialDesign:PackIcon
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#2563EB"
                                Kind="ViewDashboardOutline" />
                        </Border>
                        <TextBlock
                            Margin="0,18,0,0"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="{Binding EmptyStateTitle}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{Binding EmptyStateDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
