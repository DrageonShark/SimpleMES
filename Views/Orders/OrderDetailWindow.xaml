<Window
    x:Class="SimpleMES.Views.Orders.OrderDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SimpleMES.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="订单详情"
    Width="780"
    Height="560"
    Background="#EEF4FF"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:OrderStatusConverter x:Key="OrderStatusConverter" />
        <Style
            x:Key="GhostButtonStyle"
            BasedOn="{StaticResource MaterialDesignPaperButton}"
            TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Setter Property="materialDesign:RippleAssist.Feedback" Value="#9CA3AF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValidationTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AlertCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="#FFF7ED" />
            <Setter Property="BorderBrush" Value="#FED7AA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border
            Padding="28"
            Background="White"
            CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#0F172A"
                        Text="订单详情" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="15"
                        Foreground="#2563EB"
                        Text="{Binding Order.OrderNo}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Margin="0,0,10,0"
                        Padding="18"
                        Background="#F8FBFF"
                        CornerRadius="12">
                        <StackPanel>
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#1E3A8A"
                                Text="状态信息" />
                            <TextBlock
                                Margin="0,16,0,4"
                                Foreground="#64748B"
                                Text="当前状态" />
                            <TextBlock Text="{Binding Order.OrderStatus, Converter={StaticResource OrderStatusConverter}}" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="#64748B"
                                Text="创建时间" />
                            <TextBlock Text="{Binding Order.CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="#64748B"
                                Text="开始时间" />
                            <TextBlock Text="{Binding Order.StartTime, StringFormat='yyyy-MM-dd HH:mm:ss', TargetNullValue=-}" />
                            <TextBlock
                                Margin="0,12,0,4"
                                Foreground="#64748B"
                                Text="最后操作时间" />
                            <TextBlock Text="{Binding Order.LastOperationTime, StringFormat='yyyy-MM-dd HH:mm:ss', TargetNullValue=-}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="18"
                        Background="#F8FBFF"
                        CornerRadius="12">
                        <StackPanel>
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#1E3A8A"
                                Text="维护编辑" />
                            <TextBlock
                                Margin="0,16,0,6"
                                Foreground="#64748B"
                                Text="产品" />
                            <ComboBox
                                Height="36"
                                DisplayMemberPath="ProductName"
                                IsEnabled="{Binding CanEditOrder}"
                                ItemsSource="{Binding Products}"
                                SelectedValue="{Binding EditProductCode, Mode=TwoWay}"
                                SelectedValuePath="ProductCode" />
                            <TextBlock
                                Style="{StaticResource ValidationTextStyle}"
                                Text="{Binding ProductValidationMessage}"
                                Visibility="{Binding HasProductValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Margin="0,14,0,6"
                                Foreground="#64748B"
                                Text="计划数量" />
                            <TextBox
                                Height="36"
                                IsEnabled="{Binding CanEditOrder}"
                                Text="{Binding EditPlanQtyText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource ValidationTextStyle}"
                                Text="{Binding PlanQtyValidationMessage}"
                                Visibility="{Binding HasPlanQtyValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Margin="0,14,0,0"
                                Foreground="#64748B"
                                Text="订单号与历史时间只读，避免维护页误改主键和追溯字段。"
                                TextWrapping="Wrap" />
                            <Border
                                Margin="0,16,0,0"
                                Style="{StaticResource AlertCardStyle}"
                                Visibility="{Binding ShowEditRestriction, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    Foreground="#C2410C"
                                    Text="{Binding EditRestrictionMessage}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="2"
                    Margin="0,18,0,0"
                    Style="{StaticResource AlertCardStyle}"
                    Visibility="{Binding ShowDeleteRestriction, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        Foreground="#C2410C"
                        Text="{Binding DeleteRestrictionMessage}"
                        TextWrapping="Wrap" />
                </Border>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="110"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#FFF1F2"
                        BorderBrush="#FECDD3"
                        Command="{Binding DeleteCommand}"
                        Content="删除订单"
                        Foreground="#BE123C"
                        Visibility="{Binding HasDeleteOrderPermission, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Width="110"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        Command="{Binding SaveCommand}"
                        Content="保存修改"
                        Foreground="White"
                        Visibility="{Binding HasEditOrderPermission, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Width="96"
                        Height="38"
                        Command="{Binding CloseWindowCommand}"
                        Content="关闭"
                        Style="{StaticResource GhostButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
