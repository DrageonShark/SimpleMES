<UserControl
    x:Class="SimpleMES.Views.Controls.OrderManagementHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SimpleMES.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="24">
        <Border
            Padding="28"
            Background="#FAFBFD"
            BorderBrush="#E3E8EF"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel>
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#1F2937"
                    Text="订单维护" />
                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="14"
                    Foreground="#6B7280"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
