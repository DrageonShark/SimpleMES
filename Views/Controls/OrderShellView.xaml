<UserControl
    x:Class="SimpleMES.Views.Controls.OrderShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimpleMES.Views.Controls"
    xmlns:views="clr-namespace:SimpleMES.Views"
    xmlns:vm="clr-namespace:SimpleMES.ViewModels"
    Background="#F5F7FB">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:OrderBoardViewModel}">
            <controls:OrderBoardView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#4B1D5A">
            <StackPanel Margin="10">
                <TextBlock
                    Margin="8,8,8,16"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="订单管理" />

                <Button
                    Height="38"
                    Margin="0,0,0,8"
                    Command="{Binding ShowBoardCommand}"
                    Content="订单看板" />

                <Button
                    Height="38"
                    Margin="0,0,0,8"
                    Content="订单维护(待接入)"
                    IsEnabled="False" />

                <Button
                    Height="38"
                    Content="订单调度(待接入)"
                    IsEnabled="False" />
            </StackPanel>
        </Border>

        <Border
            Grid.Column="1"
            Margin="12"
            Background="White"
            CornerRadius="8">
            <ContentControl Content="{Binding CurrentChild}" />
        </Border>
    </Grid>
</UserControl>