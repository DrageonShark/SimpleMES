<UserControl x:Class="SimpleMES.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:state="clr-namespace:SimpleMES.Services.State"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1260">

    <UserControl.Resources>
        <!-- 通用输入框样式 -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- 通用下拉框样式 -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 次按钮 -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <!-- 设备卡片边框（按设备状态变色） -->
        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Width" Value="310"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E7EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1F2937"
                                      BlurRadius="16"
                                      ShadowDepth="3"
                                      Opacity="0.10"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Running}">
                    <Setter Property="BorderBrush" Value="#BFE8D4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                    <Setter Property="BorderBrush" Value="#F4D9A6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                    <Setter Property="BorderBrush" Value="#F1B5B5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                    <Setter Property="BorderBrush" Value="#D7DCE5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F7FB" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 搜索筛选 + 添加设备 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="设备管理中心" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="实时查看设备状态、处理告警、维护设备配置" Margin="0,3,0,0" Foreground="#6B7280"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- 搜索关键词：匹配设备名/IP/串口 -->
                    <TextBox Width="220"
                             Margin="0,0,8,0"
                             Height="34" Padding="10 0"
                             VerticalContentAlignment="Center"
                             FontSize="13" BorderBrush="#D1D5DB" BorderThickness="1" 
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <VisualBrush x:Key="HelpBrush" TileMode="None" Opacity="0.3" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock FontStyle="Italic" Text="输入设备名/IP/串口，支持模糊查询。"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 状态筛选 -->
                    <ComboBox Width="120"
                              Margin="0,0,8,0"
                              Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding StateFilterOptions}"
                              SelectedItem="{Binding StateFilter}"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="110"
                        Margin="10,0,0,0"
                        Content="添加设备"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddDeviceCommand}"/>
            </Grid>
        </Border>

        <!-- 统计卡片 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="运行中" Foreground="#065F46"/>
                    <TextBlock Text="{Binding RunningCount}" FontSize="26" FontWeight="Bold" Foreground="#065F46"/>
                </StackPanel>
            </Border>
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="未连接" Foreground="#92400E"/>
                    <TextBlock Text="{Binding DisconnectedCount}" FontSize="26" FontWeight="Bold" Foreground="#92400E"/>
                </StackPanel>
            </Border>
            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="故障" Foreground="#991B1B"/>
                    <TextBlock Text="{Binding FaultCount}" FontSize="26" FontWeight="Bold" Foreground="#991B1B"/>
                </StackPanel>
            </Border>
            <!-- 如果你暂时没做 DisabledCount，可先删掉这个卡片 -->
            <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="已停用" Foreground="#374151"/>
                    <TextBlock Text="{Binding DisabledCount}" FontSize="26" FontWeight="Bold" Foreground="#374151"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 主体：左设备卡片，右告警面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备卡片 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredDeviceDto}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 头部：设备基本信息 + 状态 -->
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="#EEF2FF">
                                                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="15" Foreground="#111827"/>
                                                <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="#6B7280"/>
                                                <TextBlock Text="{Binding SerialPort}" FontSize="12" Foreground="#9CA3AF"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 状态徽标 -->
                                        <Border DockPanel.Dock="Right" Padding="8,3" CornerRadius="10" BorderThickness="1" 
                                                Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                            <Setter Property="Background" Value="#F3F4F6"/>
                                                            <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DeviceState, Converter={StaticResource DeviceStateConverter}}" 
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- 指标区 -->
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="温度(℃)" FontSize="11" Foreground="#6B7280"/>
                                                <TextBlock Text="{Binding Temperature}" FontSize="18" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="压力(Bar)" FontSize="11" Foreground="#6B7280"/>
                                                <TextBlock Text="{Binding Pressure}" FontSize="18" FontWeight="Bold" Foreground="#B45309"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="8" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="转速(Rpm)" FontSize="11" Foreground="#6B7280"/>
                                                <TextBlock Text="{Binding Speed}" FontSize="18" FontWeight="Bold" Foreground="#991B1B"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 操作按钮 -->
                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Margin="0,0,6,0"
                                                Content="编辑设备"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.EditDeviceConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"></Setter>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Content="停用设备"
                                                Command="{Binding DataContext.ToggleDeviceEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                    <Setter Property="Content" Value="停用设备"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                            <Setter Property="Content" Value="启用设备"/>
                                                            <Setter Property="Background" Value="#059669"/>
                                                            <Setter Property="BorderBrush" Value="#059669"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <!-- 更新时间 -->
                                    <TextBlock Grid.Row="3"
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="11"
                                               Foreground="#9CA3AF"
                                               Text="{Binding LastUpdateTime, StringFormat='最后更新: {0:yyyy-MM-dd HH:mm:ss}'}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 右侧：告警面板 -->
            <Border Grid.Column="1" Margin="10,0,0,0" Padding="5"
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="系统警告信息" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="仅显示未确认告警" FontSize="12" Foreground="#6B7280"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Width="68"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="刷新"
                                Command="{Binding RefreshAlarmsCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"></Setter>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PendingAlarms}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                    CornerRadius="8"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    Background="#FEF2F2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                               Text="{Binding AlarmMessage}"
                               FontSize="13"
                               Foreground="#7F1D1D"
                               TextWrapping="Wrap"/>

                                        <!-- 底部信息 + 按钮，使用 Grid 防止时间与按钮重叠 -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                   Text="{Binding DeviceId, StringFormat=设备 #{0}}"
                                   FontSize="11"
                                   Foreground="#991B1B"/>

                                            <TextBlock Grid.Column="1"
                                   Margin="10,0,10,0"
                                   Text="{Binding AlarmTime, StringFormat={}{0:MM-dd HH:mm:ss}}"
                                   FontSize="11"
                                   Foreground="#B91C1C"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"/>

                                            <Button Grid.Column="2"
                                Content="确认"
                                Width="58"
                                Height="26"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DataContext.AckAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
