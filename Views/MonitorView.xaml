<UserControl x:Class="SimpleMES.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 10 10">
            <!-- Toast 通知测试按钮 -->
            <!--<Button Content="✅ 成功" Click="OnToastSuccess"
                    Height="34" Margin="0 0 6 0" Padding="10 0"
                    BorderThickness="0" Cursor="Hand"
                    Foreground="White" Background="#4CAF50">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
            <Button Content="❌ 错误" Click="OnToastError"
                    Height="34" Margin="0 0 6 0" Padding="10 0"
                    BorderThickness="0" Cursor="Hand"
                    Foreground="White" Background="#F44336">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
            <Button Content="ℹ 提示" Click="OnToastInfo"
                    Height="34" Margin="0 0 6 0" Padding="10 0"
                    BorderThickness="0" Cursor="Hand"
                    Foreground="White" Background="#2196F3">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
            <Button Content="⚠ 警告" Click="OnToastWarning"
                    Height="34" Margin="0 0 6 0" Padding="10 0"
                    BorderThickness="0" Cursor="Hand"
                    Foreground="White" Background="#FF9800">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
            <Button Content="❓ 询问" Click="OnToastQuestion"
                    Height="34" Margin="0 0 12 0" Padding="10 0"
                    BorderThickness="0" Cursor="Hand"
                    Foreground="White" Background="#9C27B0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>-->
            <StackPanel 
                Orientation="Horizontal" 
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="0 0 10 0">
                <TextBox Width="180" Height="30"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="100" Height="30" Margin="8,0,0,0"
                          ItemsSource="{Binding StateFilterOptions}"
                          SelectedItem="{Binding StateFilter}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RunningCount, StringFormat=运行:{0}}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding DisconnectedCount, StringFormat=断连:{0}}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding FaultCount, StringFormat=故障:{0}}" />
            </StackPanel>
            <Button 
                Content="添加设备"
                Command="{Binding AddDeviceCommand}"
                Width="100"
                Height="40"
                BorderThickness="0"
                FontWeight="Bold"
                FontSize="15"
                Cursor="Hand"
                Foreground="White"
                Background="#1976D2"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"></Setter>
                    </Style>
                </Button.Resources>
            </Button>
        </WrapPanel>
        <ScrollViewer Grid.Row="1" Margin="0 10 0 0">
            <ItemsControl ItemsSource="{Binding FilteredDeviceDto}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="280" Background="White" CornerRadius="8" Margin="0 0 20 20" Padding="15" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceState}" Value="Disconnected">
                                            <Setter Property="BorderBrush" Value="#FFC107"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DeviceState}" Value="Fault">
                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DeviceState}" Value="Running">
                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="15"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E3F2FD">
                                        <TextBlock Text="⚙️" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
                                    </Border>
                                    <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="#888"/>
                                    </StackPanel>
                                </StackPanel>
                                <Separator Background="#F0F0F0" Margin="0 0 0 15"/>
                                <DockPanel Margin="0 5">
                                    <TextBlock Text="运行状态" Foreground="#666"/>
                                    <TextBlock Text="{Binding DeviceState, Converter={StaticResource DeviceStateConverter}}" FontWeight="Bold"  HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceState}" Value="Fault">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceState}" Value="Stopped">
                                                        <Setter Property="Foreground" Value="Gray"></Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel Margin="0 5">
                                    <TextBlock Text="实时温度" Foreground="#666"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Temperature}" FontWeight="Bold" Foreground="#1976D2" FontSize="16"/>
                                        <TextBlock Text=" ℃" Foreground="#1976D2" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0 5">
                                    <TextBlock Text="实时压力" Foreground="#666"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Pressure}" FontWeight="Bold" Foreground="#FFA000" FontSize="16"/>
                                        <TextBlock Text=" Bar" Foreground="#FFA000" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0 5">
                                    <TextBlock Text="实时转速" Foreground="#666"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Speed}" FontWeight="Bold" Foreground="DarkRed" FontSize="16"/>
                                        <TextBlock Text="Rpm" Foreground="DarkRed" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0 5">
                                    <Button 
                                        Content="编辑" 
                                        Command="{Binding DataContext.EditDeviceConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Height="40"
                                        Background="#1976D2"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0 5 0 0 ">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LastUpdateTime, StringFormat='更新于: HH:mm:ss'}" FontSize="10" Foreground="#AAA" Margin="0,20,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>