<UserControl
    x:Class="SimpleMES.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SimpleMES.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:state="clr-namespace:SimpleMES.Services.State"
    d:DesignHeight="760"
    d:DesignWidth="1260"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  通用输入框样式  -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!--  通用下拉框样式  -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <!--  主按钮  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  次按钮  -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--  危险按钮  -->
        <Style
            x:Key="DangerButtonStyle"
            BasedOn="{StaticResource GhostButtonStyle}"
            TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>

        <Style x:Key="AlarmRailToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C9D3E0" />
            <Setter Property="BorderThickness" Value="0,1,2,1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,-5,-10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  设备卡片边框（按设备状态变色）  -->
        <Style x:Key="DeviceCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Width" Value="310" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7EAF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="16"
                        Opacity="0.10"
                        ShadowDepth="3"
                        Color="#1F2937" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Running}">
                    <Setter Property="BorderBrush" Value="#BFE8D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                    <Setter Property="BorderBrush" Value="#F4D9A6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                    <Setter Property="BorderBrush" Value="#F1B5B5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                    <Setter Property="BorderBrush" Value="#D7DCE5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--  侧边栏宽度值辅助改变转换器  -->
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />


    </UserControl.Resources>

    <Grid Margin="8" Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部：标题 + 搜索筛选 + 添加设备  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="14"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#111827"
                        Text="设备管理中心" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Foreground="#6B7280"
                        Text="实时查看设备状态、处理告警、维护设备配置" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  搜索关键词：匹配设备名/IP/串口  -->
                    <TextBox
                        Width="220"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        FontSize="13"
                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Resources>
                            <VisualBrush
                                x:Key="HelpBrush"
                                AlignmentX="Left"
                                Opacity="0.3"
                                Stretch="None"
                                TileMode="None">
                                <VisualBrush.Visual>
                                    <TextBlock FontStyle="Italic" Text="输入设备名/IP/串口，支持模糊查询。" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource HelpBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!--  状态筛选  -->
                    <ComboBox
                        Width="120"
                        Margin="0,0,8,0"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding StateFilterOptions}"
                        SelectedItem="{Binding StateFilter}"
                        Style="{StaticResource FilterComboBoxStyle}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Width="110"
                    Margin="10,0,0,0"
                    Command="{Binding AddDeviceCommand}"
                    Content="添加设备"
                    Style="{StaticResource PrimaryButtonStyle}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!--  统计卡片  -->
        <UniformGrid
            Grid.Row="1"
            Margin="0,0,0,10"
            Columns="4">
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="#ECFDF5"
                BorderBrush="#A7F3D0"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#065F46" Text="运行中" />
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#065F46"
                        Text="{Binding RunningCount}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="#FFFBEB"
                BorderBrush="#FDE68A"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#92400E" Text="未连接" />
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#92400E"
                        Text="{Binding DisconnectedCount}" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,0,8,0"
                Padding="12"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" Text="故障" />
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#991B1B"
                        Text="{Binding FaultCount}" />
                </StackPanel>
            </Border>
            <Border
                Padding="12"
                Background="#F3F4F6"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#374151" Text="已停用" />
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#374151"
                        Text="{Binding DisabledCount}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  主体：左设备卡片，右告警面板  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左侧：设备卡片  -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredDeviceDto}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  头部：设备基本信息 + 状态  -->
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="40"
                                                Height="40"
                                                Background="#EEF2FF"
                                                CornerRadius="20">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Text="⚙" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="#111827"
                                                    Text="{Binding DeviceName}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#6B7280"
                                                    Text="{Binding IpAddress}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#9CA3AF"
                                                    Text="{Binding SerialPort}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  状态徽标  -->
                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="8,3"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECFDF5" />
                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disconnected}">
                                                            <Setter Property="Background" Value="#FFFBEB" />
                                                            <Setter Property="BorderBrush" Value="#FDE68A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Fault}">
                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                            <Setter Property="BorderBrush" Value="#FECACA" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                            <Setter Property="BorderBrush" Value="#D1D5DB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding DeviceState, Converter={StaticResource DeviceStateConverter}}" />
                                        </Border>
                                    </DockPanel>

                                    <!--  指标区  -->
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Padding="8"
                                            Background="#EFF6FF"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#6B7280"
                                                    Text="温度(℃)" />
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#1D4ED8"
                                                    Text="{Binding Temperature}" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Padding="8"
                                            Background="#FFFBEB"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#6B7280"
                                                    Text="压力(Bar)" />
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#B45309"
                                                    Text="{Binding Pressure}" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Padding="8"
                                            Background="#FEF2F2"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#6B7280"
                                                    Text="转速(Rpm)" />
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#991B1B"
                                                    Text="{Binding Speed}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!--  操作按钮  -->
                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditDeviceConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="编辑设备"
                                            Style="{StaticResource GhostButtonStyle}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Border
                                            Grid.Column="1"
                                            BorderBrush="#DC2626"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Button
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleDeviceEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="停用设备">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource DangerButtonStyle}" TargetType="Button">
                                                        <Setter Property="Content" Value="停用设备" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeviceState}" Value="{x:Static state:DeviceState.Disabled}">
                                                                <Setter Property="Content" Value="启用设备" />
                                                                <Setter Property="Background" Value="#059669" />
                                                                <Setter Property="BorderBrush" Value="#059669" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>
                                    </Grid>

                                    <!--  更新时间  -->
                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="#9CA3AF"
                                        Text="{Binding LastUpdateTime, StringFormat='最后更新: {0:yyyy-MM-dd HH:mm:ss}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!--  按钮轨道 + 告警面板  -->
            <Border
                Grid.Column="1"
                Margin="10,0,0,0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="{Binding IsAlarmPanelCollapsed, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=275}" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <!--  左侧轨道  -->
                    <Grid Grid.Column="1" Background="#F8FAFC">
                        <Border
                            Width="1"
                            HorizontalAlignment="Right"
                            Background="#E2E8F0" />
                        <Button
                            Margin="0,10,0,0"
                            VerticalAlignment="Top"
                            Command="{Binding ToggleAlarmPanelCommand}"
                            Content="{Binding AlarmPanelToggleContent}"
                            Style="{StaticResource AlarmRailToggleButtonStyle}"
                            ToolTip="{Binding AlarmPanelToggleText}" />
                    </Grid>
                    <!--  告警内容区  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8,8,8,10">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#111827"
                                    Text="系统警告信息" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Text="仅显示未确认告警" />
                            </StackPanel>

                            <Button
                                Width="68"
                                Margin="80,0,0,0"
                                Command="{Binding RefreshAlarmsCommand}"
                                Content="刷新"
                                DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </DockPanel>

                        <ListBox
                            Grid.Row="1"
                            Margin="5,5,5,0"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding PendingAlarms}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10"
                                        Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                FontSize="13"
                                                Foreground="#7F1D1D"
                                                Text="{Binding AlarmMessage}"
                                                TextWrapping="Wrap" />

                                            <!--  底部信息 + 按钮，使用 Grid 防止时间与按钮重叠  -->
                                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#991B1B"
                                                    Text="{Binding DeviceId, StringFormat=设备 #{0}}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="10,0,10,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#B91C1C"
                                                    Text="{Binding AlarmTime, StringFormat={}{0:MM-dd HH:mm:ss}}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Button
                                                    Grid.Column="2"
                                                    Width="58"
                                                    Height="26"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Command="{Binding DataContext.AckAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="确认"
                                                    Style="{StaticResource GhostButtonStyle}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
