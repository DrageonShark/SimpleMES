<UserControl
    x:Class="SimpleMES.Views.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="16"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    Width="75"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding LoadOrdersCommand}"
                    Content="刷新" />

                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding Orders}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding OrderNo}"
                            Header="工单号" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding ProductCode}"
                            Header="产品" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding PlanQty}"
                            Header="计划数" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding CompletedQty}"
                            Header="已完成" />
                        <DataGridTextColumn
                            Width="90"
                            Binding="{Binding OrderStatus}"
                            Header="状态" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                            Header="创建时间" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Margin="16,0,0,0"
            Padding="20"
            Background="#F9FAFB"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="调度面板" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Foreground="#6B7280"
                        Text="基于当前选中的订单执行状态流转" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Border
                        Padding="12"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#6B7280" Text="当前订单" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedOrder.OrderNo, TargetNullValue=未选择订单}" />

                            <TextBlock
                                Margin="0,14,0,0"
                                Foreground="#6B7280"
                                Text="状态" />
                            <TextBlock Text="{Binding SelectedOrder.OrderStatus, TargetNullValue=-}" />

                            <TextBlock
                                Margin="0,14,0,0"
                                Foreground="#6B7280"
                                Text="产品" />
                            <TextBlock Text="{Binding SelectedOrder.ProductCode, TargetNullValue=-}" />

                            <TextBlock
                                Margin="0,14,0,0"
                                Foreground="#6B7280"
                                Text="计划数 / 完成数" />
                            <TextBlock>
                                <Run Text="{Binding SelectedOrder.PlanQty, TargetNullValue=0}" />
                                <Run Text=" / " />
                                <Run Text="{Binding SelectedOrder.CompletedQty, TargetNullValue=0}" />
                            </TextBlock>

                            <TextBlock
                                Margin="0,14,0,0"
                                Foreground="#6B7280"
                                Text="最后操作时间" />
                            <TextBlock Text="{Binding SelectedOrder.LastOperationTime, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue=-}" />
                        </StackPanel>
                    </Border>

                    <Button
                        Height="38"
                        Margin="0,20,0,8"
                        Command="{Binding StartSelectedOrderCommand}"
                        Content="执行 / 恢复"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button
                        Height="38"
                        Margin="0,0,0,8"
                        Command="{Binding PauseSelectedOrderCommand}"
                        Content="暂停"
                        Visibility="{Binding ShowPauseButton, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button
                        Height="38"
                        Command="{Binding CompleteSelectedOrderCommand}"
                        Content="完工"
                        Visibility="{Binding ShowCompleteButton, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="12"
                    Background="#EFF6FF"
                    CornerRadius="8">
                    <TextBlock
                        Foreground="#1D4ED8"
                        Text="状态流转：Pending → Producing → Paused → Producing → Completed"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
