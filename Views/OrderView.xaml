<UserControl
    x:Class="SimpleMES.Views.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="500"
    d:DesignWidth="900"
    Background="White"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,20,0"
            Padding="20"
            Background="#F9FAFB"
            CornerRadius="8">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="➕ 新建生产工单" />

                <TextBlock
                    Margin="0,10,0,5"
                    Foreground="#666"
                    Text="订单编号" />
                <TextBox
                    Height="35"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding NewOrderNo}" />

                <TextBlock
                    Margin="0,15,0,5"
                    Foreground="#666"
                    Text="产品名" />
                <ComboBox
                    Height="35"
                    Padding="5"
                    VerticalAlignment="Center"
                    DisplayMemberPath="ProductName"
                    ItemsSource="{Binding Products}"
                    SelectedValue="{Binding NewProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="ProductCode" />
                <TextBlock
                    Margin="0,15,0,5"
                    Foreground="#666"
                    Text="计划数量" />
                <TextBox
                    Height="35"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding NewPlanQty}" />

                <Button
                    Height="40"
                    Margin="0,30,0,0"
                    Background="#1976D2"
                    BorderThickness="0"
                    Command="{Binding CreateOrderCommand}"
                    Content="立即下达"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="0,0,0,15"
                FontSize="18"
                FontWeight="Bold"
                Text="📋 订单列表" />
            <Button
                Width="100"
                Margin="0,0,0,10"
                HorizontalAlignment="Right"
                Background="#2563EB"
                BorderBrush="#2563EB"
                Command="{Binding LoadOrdersCommand}"
                Content="刷新数据"
                Foreground="White" />

            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                Background="White"
                BorderBrush="#EEE"
                BorderThickness="1"
                CanUserAddRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Orders}"
                RowHeaderWidth="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F5F5" />
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="#555" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="0,8" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding OrderNo}"
                        Header="工单号" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding ProductCode}"
                        Header="产品" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding PlanQty}"
                        Header="计划数" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding CompletedQty}"
                        Header="已完成" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding OrderStatus}"
                        Header="状态" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                        Header="创建时间" />
                    <DataGridTemplateColumn Width="180" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="60"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.StartOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="执行" />
                                    <Button
                                        Width="60"
                                        Command="{Binding DataContext.PauseOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="暂停" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>