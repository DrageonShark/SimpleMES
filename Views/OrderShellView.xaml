<UserControl
    x:Class="SimpleMES.Views.Controls.OrderShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SimpleMES.Views.Controls"
    xmlns:orderViewModels="clr-namespace:SimpleMES.ViewModels.OrderViewModels"
    xmlns:views="clr-namespace:SimpleMES.Views"
    xmlns:vm="clr-namespace:SimpleMES.ViewModels"
    Background="#F5F7FB">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type orderViewModels:OrderBoardViewModel}">
            <controls:OrderBoardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type orderViewModels:OrderManagementHomeViewModel}">
            <controls:OrderManagementHomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OrderViewModel}">
            <views:OrderView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F5F7FB">
        <Border
            Margin="12"
            Background="White"
            CornerRadius="10">
            <ContentControl Content="{Binding CurrentChild}" />
        </Border>
    </Grid>
</UserControl>